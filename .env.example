# Credenciales del Administrador Inicial (se hashean al primer inicio)
DEFAULT_ADMIN_EMAIL=admin@ejemplo.com
DEFAULT_ADMIN_PASSWORD=contrasena_segura_aqui

# Configuración de Base de Datos (SQL Server)
# Formato: sqlserver://[HOST]:[PORT];database=[DB_NAME];user=[USER];password=[PASS];encrypt=true;trustServerCertificate=true;
DATABASE_URL="sqlserver://localhost:1433;database=kfg_ecosystem;user=TU_USUARIO;password=TU_PASSWORD;encrypt=true;trustServerCertificate=true;"

# Opcional: Especificar el driver de ODBC si es distinto al Driver 17
# SQL_DRIVER={ODBC Driver 18 for SQL Server}

# Almacenamiento de documentos de clientes: 'local' | 'sharepoint'
STORAGE_PROVIDER=local

# Solo para STORAGE_PROVIDER=sharepoint (integracion pendiente de implementar)
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# SHAREPOINT_SITE_ID=
# SHAREPOINT_DRIVE_ID=
