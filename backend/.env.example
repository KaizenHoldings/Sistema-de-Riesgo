# Credenciales del Administrador Inicial (se registran al primer inicio si no existen)
DEFAULT_ADMIN_EMAIL=admin@kfg.com
DEFAULT_ADMIN_PASSWORD=contrasena_segura_aqui

# Secreto de firma JWT (OBLIGATORIO: al menos 32 caracteres)
JWT_SECRET_KEY=clave_secreta_jwt_de_al_menos_32_caracteres_aleatorios_12345

# Configuración de Base de Datos (SQL Server)
# Formato: sqlserver://[HOST]:[PORT];database=[DB_NAME];user=[USER];password=[PASS];encrypt=true;trustServerCertificate=true;
DATABASE_URL="sqlserver://127.0.0.1:1433;database=kfg_ecosystem;user=sa;password=TuPasswordSeguro123!;encrypt=true;trustServerCertificate=true;"

# Driver ODBC:
# En Linux/Ubuntu con Docker se instala automáticamente "ODBC Driver 18 for SQL Server".
# Si se deja vacío, el sistema detecta automáticamente Driver 18 o Driver 17 instalado en el SO.
# SQL_DRIVER="{ODBC Driver 18 for SQL Server}"

# Auto-creación/verificación del esquema de base de datos al arrancar
AUTO_INIT_DB=true

# Almacenamiento de documentos de clientes: 'local' | 'sharepoint'
STORAGE_PROVIDER=local

# Solo para STORAGE_PROVIDER=sharepoint
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# SHAREPOINT_SITE_ID=
# SHAREPOINT_DRIVE_ID=
